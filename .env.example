# Context[X]MCP Environment Configuration

# MCP Server Configuration
MCP_PORT=3002
NODE_ENV=development
DEBUG=false

# Agent Configuration
AGENT_MAX_CONCURRENCY=5
AGENT_TIMEOUT=30000
AGENT_RETRY_ATTEMPTS=3

# Context Settings
CONTEXT_HISTORY_SIZE=1000
CONTEXT_RELEVANCE_THRESHOLD=0.7
CONTEXT_MAX_DEPTH=10

# Browser[X]MCP Integration
BROWSER_X_MCP_URL=http://localhost:3001
BROWSER_X_MCP_ENABLED=true
BROWSER_X_MCP_TIMEOUT=60000

# Vector Storage Configuration
VECTOR_DB_PATH=./data/vectors
VECTOR_SIMILARITY_THRESHOLD=0.8
VECTOR_MAX_RESULTS=20

# Quality Assessment
QUALITY_MIN_SCORE=0.6
QUALITY_MAX_SOURCES=10
QUALITY_TIMEOUT=15000

# Topic Detection
TOPIC_CONFIDENCE_THRESHOLD=0.75
TOPIC_MAX_CATEGORIES=5
TOPIC_LANGUAGE=en

# Memory Agent Settings
MEMORY_RETENTION_DAYS=30
MEMORY_MAX_ENTRIES=10000
MEMORY_CLEANUP_INTERVAL=3600000

# Tool Orchestrator Settings
TOOL_DISCOVERY_ENABLED=true
TOOL_DISCOVERY_INTERVAL=300000
TOOL_MAX_PARALLEL=3

# Performance Optimization
PERFORMANCE_CACHE_TTL=300000
PERFORMANCE_MAX_CACHE_SIZE=1000
PERFORMANCE_METRICS_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/context-x-mcp.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5 